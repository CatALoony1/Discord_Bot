<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <title>Datenbank - Dashboard</title>
    <script src="https://unpkg.com/@giphy/js-fetch-api/dist/giphy-js-fetch-api.bundle.js"></script>
  <script src="https://unpkg.com/@giphy/js-components/dist/giphy-js-components.bundle.js"></script>
  
  <style>
.giphy-modal {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 450px;
    max-width: 90vw;
    height: 550px;
    background: #fff; /* ODER #121212, damit man den Hintergrund sieht */
    border: 1px solid #ccc;
    z-index: 1000;
    flex-direction: column;
  }

  .giphy-modal.active {
    display: flex;
  }

  #giphyGrid {
    flex: 1;
    overflow-y: auto;
  }
  </style>
  </head>
  <body>
    <h1>Server & Datenbank</h1>
    <% if (error) { %>
    <div class="error-box">
      <strong>Fehler:</strong>
      <%= error %>
    </div>
    <% } %>
<form action="/serverconfig" method="GET">
  <label for="serverId">Wähle einen Server:</label>
  <select name="serverId" id="serverId" onchange="this.form.submit()">
    <option value="" <%= !selectedServerId ? 'disabled' : '' %>>-- Bitte wählen --</option>
    <% servers.forEach(function(server, index) { %>
      <% 
        const isSelected = selectedServerId 
          ? server.id === selectedServerId 
          : index === 0; 
      %>
      <option value="<%= server.id %>" <%= isSelected ? 'selected' : '' %>>
        <%= server.name %>
      </option>
    <% }); %>
  </select>
</form>

    <br />
    <hr />
    <br />

    <% if (selectedServerId && alleRollen.length > 0 ) { %>
    <h2>Gefundene Einträge:</h2>
    <table border="1" cellpadding="5" style="border-collapse: collapse">
      <thead>
        <tr>
         <th>Nutzung</th>
          <th>Variable</th>
          <th>Kanal</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= uses.MITGLIED_ROLE_ID %></td>
          <td>MITGLIED_ROLE_ID</td>
          <td>
            <form action="/serverconfig/change-member-role" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="newMemberRole" onchange="this.form.submit()">
                  <% alleRollen.forEach(function(role) { %>
                <option value="<%= role.id %>" <%= role.id === defaultRole ? 'selected' : '' %>>
                    <%= role.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
    <% } %>
    <br />
    <hr />
    <br />
<form action="/serverconfig/welcomemessage" method="POST">
  <input type="hidden" name="guildId" value="<%= selectedServerId %>">
  <input type="hidden" name="giphyId" id="welcomeGifId" value="<%= (gifTextList.get('WELCOME') && gifTextList.get('WELCOME').gif) ? gifTextList.get('WELCOME').gif : '' %>">
  
  <h3>Willkommensnachricht:</h3>
  <textarea id="welcomeText" name="welcomeText" rows="5" cols="90" required><% if (gifTextList.get("WELCOME")) { %><%= gifTextList.get("WELCOME").text %><% } %></textarea>
  <br /><br /><br />
  
  <div id="welcomeGifPreview">
    <% if (gifTextList.get("WELCOME") && gifTextList.get("WELCOME").gif !== '') { %>
      <img class="selected-gif-preview" src="https://media.giphy.com/media/<%= gifTextList.get('WELCOME').gif %>/giphy.gif">
    <% } %>
  </div>
  
  <button type="button" onclick="openGiphyModal('welcomeGifId', 'welcomeGifPreview')">
    GIF auswählen / ändern
  </button>
  <button type="button" onclick="clearGif('welcomeGifId', 'welcomeGifPreview')">Gif entfernen</button>
  <button type="submit">Speichern</button>
</form>

<hr>

<form action="/serverconfig/byegif" method="POST">
  <input type="hidden" name="guildId" value="<%= selectedServerId %>">
  <input type="hidden" name="giphyId" id="byeGifId" value="<%= (gifTextList.get('BYE') && gifTextList.get('BYE').gif) ? gifTextList.get('BYE').gif : '' %>">
  
  <h3>Verabschiedungsnachricht:</h3>
  <textarea id="byeText" name="byeText" rows="5" cols="90" required><% if (gifTextList.get("BYE")) { %><%= gifTextList.get("BYE").text %><% } %></textarea>
  <br /><br /><br />
  
  <div id="byeGifPreview">
    <% if (gifTextList.get("BYE") && gifTextList.get("BYE").gif !== '') { %>
      <img class="selected-gif-preview" src="https://media.giphy.com/media/<%= gifTextList.get('BYE').gif %>/giphy.gif">
    <% } %>
  </div>
  
  <button type="button" onclick="openGiphyModal('byeGifId', 'byeGifPreview')">
    GIF auswählen / ändern
  </button>
  <button type="button" onclick="clearGif('byeGifId', 'byeGifPreview')">Gif entfernen</button>
  <button type="submit">Speichern</button>
</form>

<div id="giphyModal" class="giphy-modal">
  <div class="giphy-header">
    <input type="text" id="giphySearch" placeholder="In Giphy suchen..." oninput="debounceSearch()">
    <button type="button" class="giphy-close" onclick="closeGiphyModal()">&times;</button>
  </div>
  <div id="giphyGrid" onscroll="handleScroll()"></div>
</div>

<br /><br />
    <a href="/">Zurück zur Startseite</a>

<script>
  const GIPHY_API_KEY = '<%= giphyApiKey %>';
  let currentSearch = '';
  let debounceTimer;
  let currentOffset = 0;
  let isLoading = false;
  let hasMore = true;
  let activeInputId = null;
  let activePreviewId = null;

  function clearGif(inputId, previewId) {
  document.getElementById(inputId).value = '';
  document.getElementById(previewId).innerHTML = '';
}
  function openGiphyModal(inputId, previewId) {
    activeInputId = inputId;
    activePreviewId = previewId;
    const modal = document.getElementById('giphyModal');
    modal.classList.add('active');
    document.getElementById('giphySearch').value = '';
    currentSearch = '';
    currentOffset = 0;
    hasMore = true;
    document.getElementById('giphyGrid').innerHTML = '';
    
    fetchGifs();
  }

  function closeGiphyModal() {
    document.getElementById('giphyModal').classList.remove('active');
  }

  function debounceSearch() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      currentSearch = document.getElementById('giphySearch').value.trim();
      currentOffset = 0;
      hasMore = true;
      document.getElementById('giphyGrid').innerHTML = '';
      fetchGifs();
    }, 300);
  }

  async function fetchGifs() {
    if (isLoading || !hasMore) return;
    isLoading = true;
    const endpoint = currentSearch ? 'search' : 'trending';
    const queryParam = currentSearch ? `&q=${encodeURIComponent(currentSearch)}` : '';
    const url = `https://api.giphy.com/v1/gifs/${endpoint}?api_key=${GIPHY_API_KEY}&limit=20&offset=${currentOffset}${queryParam}`;
    try {
      const response = await fetch(url);
      const { data, pagination } = await response.json();
      if (!data || data.length === 0) {
        hasMore = false;
        if (currentOffset === 0) {
          document.getElementById('giphyGrid').innerHTML = '<p style="color: white; padding: 10px;">Keine GIFs gefunden.</p>';
        }
        return;
      }

      const grid = document.getElementById('giphyGrid');
      data.forEach(gif => {
        const img = document.createElement('img');
        img.src = gif.images.fixed_height_small.url;
        img.style.width = '48%';
        img.style.margin = '1%';
        img.style.borderRadius = '6px';
        img.style.cursor = 'pointer';
        img.style.objectFit = 'cover';
        img.onclick = () => selectGif(gif);
        grid.appendChild(img);
      });
      currentOffset += data.length;
      if (currentOffset >= pagination.total_count) {
        hasMore = false;
      }
    } catch (err) {
      console.error('Fehler beim Laden der GIFs:', err);
    } finally {
      isLoading = false;
    }
  }

  function handleScroll() {
    const grid = document.getElementById('giphyGrid');
    if (grid.scrollTop + grid.clientHeight >= grid.scrollHeight - 50) {
      fetchGifs();
    }
  }

  function selectGif(gif) {
    if (activeInputId) {
      document.getElementById(activeInputId).value = gif.id;
    }
    if (activePreviewId) {
      const preview = document.getElementById(activePreviewId);
      if (preview) {
        preview.innerHTML = `<img class="selected-gif-preview" src="${gif.images.fixed_height.url}">`;
      }
    }
    closeGiphyModal();
  }
</script>
  </body>
</html>