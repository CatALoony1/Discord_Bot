<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <title>Datenbank - Dashboard</title>
    <script src="https://unpkg.com/@giphy/js-fetch-api/dist/giphy-js-fetch-api.bundle.js"></script>
  <script src="https://unpkg.com/@giphy/js-components/dist/giphy-js-components.bundle.js"></script>
  
  <style>
    .giphy-modal {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 450px;
      max-width: 90vw;
      height: 550px;
      background: #121212;
      border: 1px solid #333;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      z-index: 1000;
      padding: 15px;
      box-sizing: border-box;
      flex-direction: column;
    }

    .giphy-modal.active {
      display: flex;
    }

    .giphy-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      color: white;
    }

    .giphy-header input {
      width: 80%;
      padding: 8px;
      border-radius: 6px;
      border: 1px solid #444;
      background: #222;
      color: #fff;
    }

    .giphy-close {
      background: transparent;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
    }

    #giphyGrid {
      flex: 1;
      overflow-y: auto;
    }

    .selected-gif-preview {
      margin-top: 10px;
      max-width: 200px;
    }
  </style>
  </head>
  <body>
    <h1>Server & Datenbank</h1>
    <% if (error) { %>
    <div class="error-box">
      <strong>Fehler:</strong>
      <%= error %>
    </div>
    <% } %>
<form action="/serverconfig" method="GET">
  <label for="serverId">Wähle einen Server:</label>
  <select name="serverId" id="serverId" onchange="this.form.submit()">
    <option value="" <%= !selectedServerId ? 'disabled' : '' %>>-- Bitte wählen --</option>
    <% servers.forEach(function(server, index) { %>
      <% 
        const isSelected = selectedServerId 
          ? server.id === selectedServerId 
          : index === 0; 
      %>
      <option value="<%= server.id %>" <%= isSelected ? 'selected' : '' %>>
        <%= server.name %>
      </option>
    <% }); %>
  </select>
</form>

    <br />
    <hr />
    <br />

    <% if (selectedServerId && alleRollen.length > 0 ) { %>
    <h2>Gefundene Einträge:</h2>
    <table border="1" cellpadding="5" style="border-collapse: collapse">
      <thead>
        <tr>
         <th>Nutzung</th>
          <th>Variable</th>
          <th>Kanal</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= uses.MITGLIED_ROLE_ID %></td>
          <td>MITGLIED_ROLE_ID</td>
          <td>
            <form action="/serverconfig/change-member-role" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="newMemberRole" onchange="this.form.submit()">
                  <% alleRollen.forEach(function(role) { %>
                <option value="<%= role.id %>" <%= role.id === defaultRole ? 'selected' : '' %>>
                    <%= role.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
    <% } %>
    <br /><br />
<form action="/serverconfig/welcomegif" method="POST">
    <input type="hidden" name="giphyId" id="giphyIdInput">
    <h3>GIF auswählen:</h3>
    <div id="previewContainer"></div>
    <button type="button" onclick="openGiphyModal()">GIF suchen & auswählen</button>
    <br><br>
    <button type="submit">Speichern</button>
  </form>
<div id="giphyModal" class="giphy-modal">
    <div class="giphy-header">
      <input type="text" id="giphySearch" placeholder="In Giphy suchen..." oninput="debounceSearch()">
      <button class="giphy-close" onclick="closeGiphyModal()">&times;</button>
    </div>
    <div id="giphyGrid"></div>

    <br /><br />
    <a href="/">Zurück zur Startseite</a>
      <script>
  const GIPHY_API_KEY = '<%= giphyApiKey %>';
  
  // GiphyFetch & renderGrid aus den globalen Objekten der Bundles holen
  const gf = new GiphyJS.GiphyFetch(GIPHY_API_KEY);
  const renderGrid = GiphyJSComponents.renderGrid;

  let currentSearch = '';
  let debounceTimer;

  function openGiphyModal() {
    const modal = document.getElementById('giphyModal');
    modal.classList.add('active');

    // 50ms Warten, damit CSS 'display: flex' greift und der Container eine echte Breite > 0 hat
    setTimeout(() => {
      drawGrid();
    }, 50);
  }

  function closeGiphyModal() {
    document.getElementById('giphyModal').classList.remove('active');
  }

  function debounceSearch() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      currentSearch = document.getElementById('giphySearch').value;
      drawGrid();
    }, 300);
  }

  function drawGrid() {
    const container = document.getElementById('giphyGrid');
    if (!container) return;

    container.innerHTML = ''; // Container säubern

    // Fallback falls clientWidth im Modal noch nicht berechnet wurde
    const width = container.clientWidth > 0 ? container.clientWidth - 20 : 400;

    const fetchGifs = (offset) => {
      if (currentSearch.trim()) {
        return gf.search(currentSearch, { offset, limit: 20 });
      }
      return gf.trending({ offset, limit: 20 });
    };

    // renderGrid aus GiphyJSComponents aufrufen
    renderGrid(
      {
        width: width,
        fetchGifs: fetchGifs,
        columns: 2,
        gutter: 6,
        onGifClick: (gif, e) => {
          e.preventDefault();
          
          // 1. ID speichern
          document.getElementById('giphyIdInput').value = gif.id;

          // 2. Vorschau anzeigen
          const preview = document.getElementById('previewContainer');
          if (preview) {
            preview.innerHTML = `<img class="selected-gif-preview" src="${gif.images.fixed_height.url}">`;
          }

          // 3. Schließen
          closeGiphyModal();
        }
      },
      container
    );
  }
</script>
  </body>
</html>
