<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <title>Datenbank - Dashboard</title>
  </head>
  <body>
    <h1>Server & Datenbank</h1>
    <% if (error) { %>
    <div class="error-box">
      <strong>Fehler:</strong>
      <%= error %>
    </div>
    <% } %>
    <form action="/channelselection" method="GET">
      <label for="serverId">Wähle einen Server:</label>
      <select name="serverId" id="serverId" onchange="this.form.submit()">
        <option value="">-- Bitte wählen --</option>
            <% servers.forEach(function(server) { %>
                <option value="<%= server.id %>" <%= server.id === selectedServerId ? 'selected' : '' %>>
                    <%= server.name %>
                </option>
            <% }); %>
        </select>
    </form>

    <br />
    <hr />
    <br />

    <% if (selectedServerId && alleTextChannels.length > 0 && alleVoiceChannels.length > 0) { %>
    <h2>Gefundene Einträge:</h2>
    <table border="1" cellpadding="5" style="border-collapse: collapse">
      <thead>
        <tr>
         <th>Nutzung</th>
          <th>Variable</th>
          <th>Kanal</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= uses.ALLGEMEIN_ID %></td>
          <td>ALLGEMEIN_ID</td>
          <td>
            <form action="channelselection/select-channel-allgemein" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="allgemein" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(server) { %>
                <option value="<%= alleTextChannels.id %>" <%= alleTextChannels.id === defaultValues.ALLGEMEIN_ID ? 'selected' : '' %>>
                    <%= alleTextChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.BYE_ID %></td>
          <td>BYE_ID</td>
          <td>
            <form action="channelselection/select-channel-bye" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="bye" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(server) { %>
                <option value="<%= alleTextChannels.id %>" <%= alleTextChannels.id === defaultValues.BYE_ID ? 'selected' : '' %>>
                    <%= alleTextChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.LOG_ID %></td>
          <td>LOG_ID</td>
          <td>
            <form action="channelselection/select-channel-log" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="log" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(server) { %>
                <option value="<%= alleTextChannels.id %>" <%= alleTextChannels.id === defaultValues.LOG_ID ? 'selected' : '' %>>
                    <%= alleTextChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.BUMP_ID %></td>
          <td>BUMP_ID</td>
          <td>
            <form action="channelselection/select-channel-bump" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="bump" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(server) { %>
                <option value="<%= alleTextChannels.id %>" <%= alleTextChannels.id === defaultValues.BUMP_ID ? 'selected' : '' %>>
                    <%= alleTextChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.QUIZ_ID %></td>
          <td>QUIZ_ID</td>
          <td>
            <form action="channelselection/select-channel-quiz" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="quiz" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(server) { %>
                <option value="<%= alleTextChannels.id %>" <%= alleTextChannels.id === defaultValues.QUIZ_ID ? 'selected' : '' %>>
                    <%= alleTextChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.ADMIN_C_ID %></td>
          <td>ADMIN_C_ID</td>
          <td>
            <form action="channelselection/select-channel-admin" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="admin" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(server) { %>
                <option value="<%= alleTextChannels.id %>" <%= alleTextChannels.id === defaultValues.ADMIN_C_ID ? 'selected' : '' %>>
                    <%= alleTextChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.SPIELE_ID %></td>
          <td>SPIELE_ID</td>
          <td>
            <form action="channelselection/select-channel-spiele" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="spiele" onchange="this.form.submit()">
                  <% alleTextChannels.forEach(function(server) { %>
                <option value="<%= alleTextChannels.id %>" <%= alleTextChannels.id === defaultValues.SPIELE_ID ? 'selected' : '' %>>
                    <%= alleTextChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
        <tr>
          <td><%= uses.VCCREATION_ID %></td>
          <td>VCCREATION_ID</td>
          <td>
            <form action="channelselection/select-channel-vccreation" method="POST">
              <input type="hidden" name="guildId" value="<%= selectedServerId %>">
                <select name="vccreation" onchange="this.form.submit()">
                  <% alleVoiceChannels.forEach(function(server) { %>
                <option value="<%= alleVoiceChannels.id %>" <%= alleVoiceChannels.id === defaultValues.VCCREATION_ID ? 'selected' : '' %>>
                    <%= alleVoiceChannels.name %>
                </option>
            <% }); %>
                </select>
            </form>
          </td>
        </tr>
      </tbody>
    </table>
    <% } else if (selectedServerId && selectedTable) { %>
    <p>Es gibt keine Datensätze</p>
    <% } %>

    <br /><br />
    <a href="/">Zurück zur Startseite</a>
  </body>
</html>
